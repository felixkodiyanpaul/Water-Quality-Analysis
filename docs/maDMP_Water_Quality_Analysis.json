    "project": [
      {
        "title": "Water Quality Analysis Using National Lake Monitoring Data",
        "description": "Machine learning-based water quality classification using national lake monitoring data from Lithuania, published by Aplinkos apsaugos agentūra and obtained from the European Open Data Portal (data.europa.eu). The dataset contains 1,935 records and 116 variables covering physicochemical parameters, heavy metals, and priority pollutants. The experiment implements a fully FAIR open-science pipeline with structured data storage in DBRepo, standards-compliant metadata (RO-Crate, CodeMeta, FAIR4ML, Croissant, Model Card), and all artefacts published with persistent identifiers on GitHub, Zenodo, and TU Wien Research Data Repository.",
        "start": "2026-05-01",
        "end": "2026-05-30",
        "funding": []
      }
